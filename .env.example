# Copy to .env and adjust. Never commit .env.

# --- Postgres / PostGIS (docker-compose service "postgres") ---
POSTGRES_USER=arco
POSTGRES_PASSWORD=arco_dev_password
POSTGRES_DB=arco
POSTGRES_PORT=5432
# Used by services running on the host. Inside compose, host is "postgres".
DATABASE_URL=postgresql+psycopg://arco:arco_dev_password@localhost:5432/arco

# --- Redis (optional; blackboard falls back to Postgres LISTEN/NOTIFY if unset/unreachable) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Service ports (host side) ---
BLACKBOARD_PORT=8001
BASE_STATION_PORT=8002
AGENTS_PORT=8003
SIMULATOR_PORT=8004
DASHBOARD_PORT=3000

# --- Agents / SLM ---
ARCO_SLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
ARCO_SLM_MODEL=qwen2.5:1.5b-instruct

# --- Vision ---
# onnx_split | onnx_full | synthetic
ARCO_DETECTOR=synthetic
ARCO_MODELS_DIR=./models

# --- Logging ---
ARCO_LOG_LEVEL=INFO
ARCO_LOG_JSON=true
