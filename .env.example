# Copy to .env and adjust. Never commit .env.

# --- Postgres / PostGIS (docker-compose service "postgres") ---
POSTGRES_USER=arco
POSTGRES_PASSWORD=arco_dev_password
POSTGRES_DB=arco
POSTGRES_PORT=5432
# Used by services running on the host. Inside compose, host is "postgres".
DATABASE_URL=postgresql+psycopg://arco:arco_dev_password@localhost:5432/arco

# --- Redis (optional; blackboard falls back to Postgres LISTEN/NOTIFY if unset/unreachable) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Redis Pub/Sub channel prefix (Pub/Sub is server-wide; tests use blackboard-test.)
ARCO_BUS_PREFIX=blackboard.
# Tests run in <db>_test + redis db 9 + prefix above; override if needed:
# ARCO_TEST_DATABASE_URL=postgresql+psycopg://arco:arco_dev_password@localhost:5432/arco_test
# ARCO_TEST_REDIS_URL=redis://localhost:6379/9

# --- Service ports (host side) ---
BLACKBOARD_PORT=8001
BASE_STATION_PORT=8002
AGENTS_PORT=8003
SIMULATOR_PORT=8004
BENCHMARK_PORT=8005
DASHBOARD_PORT=3000

# --- Agents / SLM ---
ARCO_SLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
ARCO_SLM_MODEL=qwen2.5:1.5b-instruct
# Origin cells + safe zones the Navigator routes for (relative to repo root). A full
# scenario file also works. Phase 7 scenarios override this.
ARCO_POPULATION_PATH=data/samples/lahaina/demo_population.json
# Wall-clock seconds between agent ticks (TTL expiry, fire-front buffer growth)
ARCO_AGENTS_TICK_S=5

# --- Vision ---
# onnx_split | synthetic   (onnx_full is the in-process benchmark baseline, not a service mode)
ARCO_DETECTOR=synthetic
ARCO_MODELS_DIR=./models
ARCO_MODEL_ID=yolov8n-seg
# Force ORT providers (comma list); default auto: TensorRT > CUDA > CPU
# ARCO_ORT_PROVIDERS=CPUExecutionProvider
BLACKBOARD_URL=http://localhost:8001
# Edge node (host-side `make run-edge` / compose profile `vision`)
ARCO_EDGE_STREAM=micro
ARCO_EDGE_SOURCE=synthetic
ARCO_EDGE_GEOREF_PATH=data/samples/vision/georef/camera_front_st.json
ARCO_EDGE_FPS=5
ARCO_BASE_STATION_URL=ws://localhost:8002/ws/features
# Edge refuses non-local base stations unless this is 1 (features only; never pixels)
ARCO_ALLOW_REMOTE_BASE=0

# --- Logging ---
ARCO_LOG_LEVEL=INFO
ARCO_LOG_JSON=true
